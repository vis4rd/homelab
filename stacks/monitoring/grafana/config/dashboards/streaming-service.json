        {
            "id": 5,
            "type": "stat",
            "title": "Usenet downloaded last 30 days",
            "gridPos": {
                "h": 5,
                "w": 4,
                "x": 16,
                "y": 0
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "expr": "increase(sabnzbd_downloaded_bytes[30d]) / 1000000000",
                    "refId": "A",
                    "instant": true
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "decgbytes"
                },
                "overrides": []
            }
        },
        {
            "id": 6,
            "type": "stat",
            "title": "Exporters",
            "gridPos": {
                "h": 5,
                "w": 4,
                "x": 20,
                "y": 0
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "expr": "min(up{job=~\"jellyfin-json-exporter.*|sabnzbd-exporter\"})",
                    "refId": "A",
                    "instant": true
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "min": 0,
                    "max": 1
                },
                "overrides": []
            }
        },
        {
            "id": 7,
            "type": "barchart",
            "title": "Distinct users per day",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 5
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "expr": "max by (date, username) (last_over_time(streaming_jellyfin_active_user_daily_active[30d]))",
                    "format": "table",
                    "instant": true,
                    "refId": "A"
                }
            ],
            "transformations": [
                {
                    "id": "labelsToFields",
                    "options": {
                        "mode": "columns",
                        "valueLabel": "username"
                    }
                },
                {
                    "id": "groupingToMatrix",
                    "options": {
                        "columnField": "username",
                        "rowField": "date",
                        "valueField": "Value"
                    }
                }
            ],
            "options": {
                "xAxis": {
                    "mode": "series"
                },
                "xTickLabelRotation": 90,
                "orientation": "vertical",
                "showValue": "never",
                "stacking": "normal",
                "groupWidth": 0.8,
                "barWidth": 0.8,
                "tooltip": {
                    "mode": "single",
                    "sort": "none"
                },
                "legend": {
                    "showLegend": true,
                    "displayMode": "list",
                    "placement": "bottom"
                }
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "decimals": 0,
                    "min": 0,
                    "color": {
                        "mode": "palette-classic"
                    }
                },
                "overrides": []
            }
        },
